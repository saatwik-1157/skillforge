# ============================================================================
# SkillForge — Docker Compose variables (copy to ./.env next to docker-compose.yml)
#
# This root file is read ONLY by `docker compose`. Each app has its own example
# for running outside Docker:
#   apps/api/.env.example  -> apps/api/.env        (API + Prisma)
#   apps/web/.env.example  -> apps/web/.env.local  (Next.js)
# Every value below has a default in docker-compose.yml, so this file is optional.
# ============================================================================

# ---- Postgres container ----
POSTGRES_USER=skillforge
POSTGRES_PASSWORD=skillforge
POSTGRES_DB=skillforge

# ---- API container ----
NODE_ENV=development
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- Web container (baked into the Next.js build as a build arg) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
