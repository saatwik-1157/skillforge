# ============================================================================
# SkillForge API (apps/api) — copy to apps/api/.env and fill in.
# The API loads .env from its working directory (apps/api) via dotenv, and
# the Prisma CLI reads the same file. Every variable read by
# src/config/env.ts, src/utils/logger.ts and prisma/schema.prisma is listed.
# ============================================================================

# ---- Database (Prisma) ----
# Local Postgres from `docker compose up -d db` uses these credentials.
DATABASE_URL="postgresql://skillforge:skillforge@localhost:5432/skillforge?schema=public"
# Required by prisma/schema.prisma (directUrl). Locally and on Render it is the
# same as DATABASE_URL; on Supabase use the session/direct connection string.
DIRECT_URL="postgresql://skillforge:skillforge@localhost:5432/skillforge?schema=public"

# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Allowed CORS origin (the web app's URL).
CLIENT_URL=http://localhost:3000

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email / SMTP (optional; emails are logged when SMTP_HOST+SMTP_USER are unset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkillForge <no-reply@skillforge.app>"

# ---- Cloudinary (optional; uploads disabled when unset) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---- Logging ----
# true = pino-pretty output in development (ignored in production).
LOG_PRETTY=false
