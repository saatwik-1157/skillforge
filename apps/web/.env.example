# ============================================================================
# SkillForge web app (apps/web) — copy to apps/web/.env.local and fill in.
# NEXT_PUBLIC_* values are baked in at BUILD time (rebuild after changing them).
# ============================================================================

# API base URL the browser calls. Either an absolute URL
# (e.g. http://localhost:4000/api/v1) or a relative "/api/v1", which next.config.mjs
# proxies to API_PROXY_TARGET (and netlify.toml routes to the API function).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Only used when NEXT_PUBLIC_API_URL is relative: where `next dev`/`next start`
# proxy /api/* to. Read when next.config.mjs is evaluated (dev start / build).
# Default in next.config.mjs is http://localhost:4055.
API_PROXY_TARGET=http://localhost:4000

# Web3Forms public access key for the landing-page newsletter form (optional).
NEXT_PUBLIC_WEB3FORMS_KEY=
